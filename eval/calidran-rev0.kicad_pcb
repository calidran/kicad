	(footprint "USB_Micro-AB_Hirose_ZX62-AB-5PA"
		(layer "F.Cu")
		(uuid "0fc398db-9d2d-47fa-88d3-eba7f3db8b03")
		(at 16.25 34.5 180)
		(descr "Hirose ZX62-AB-5PA(31) Micro-USB Type-AB receptacle, right-angle SMT, horizontal mount. Hand-built from Hirose catalog EDC-126557-31-00 (CAL-151). Origin = connector centerline at the PCB edge; local +Y points onto the board (toward components). Signal pads 1-5 = VBUS,D-,D+,ID,GND, 0.65mm pitch. Pad 6 = the two SMT shield/mounting tabs, tied to GND via Shield pin 6 on the USB_B_Micro symbol (CAL-151 follow-up; electrical ruling - shell to signal GND for an ESD discharge path). Pin1 at local X=-1.30; confirm pin1 side against the Hirose engineering drawing before production tape-out.")
